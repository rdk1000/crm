{
  "name": "relay-desktop",
  "productName": "Relay",
  "version": "0.1.0",
  "description": "Desktop shell for the Relay CRM",
  "homepage": "https://github.com/rubende2013/crm",
  "license": "MIT",
  "author": "Ruben de Kleijn <rubendekleijn2000@gmail.com>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.relay.crm",
    "productName": "Relay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["main.js", "package.json"],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "Relay-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Relay-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "Relay-Linux-${arch}.${ext}"
    }
  }
}
